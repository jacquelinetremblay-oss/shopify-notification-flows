{% endcapture %}
{% capture email_sub_title %}
  Place your first B2B order
{% endcapture %}
{% capture email_body %}
  You now have access to start placing B2B orders with <a target="_blank" href="{{shop_link}}">{{shop_name}}</a>. Log in to place your first order. Your company name is {{company.name}}. Your name is {{customer.name}}
{% endcapture %}
{% capture credit_line_message %}
<a href="https://ca.docusign.net/Member/PowerFormSigning.aspx?PowerFormId=bade305f-c581-48a7-8124-c1edfa2de79c&env=ca&acct=680a5f63-3aa7-4ecf-8dc6-eec4880677e2&v=2">Complete the Guillevin credit application</a>
{% endcapture %}

